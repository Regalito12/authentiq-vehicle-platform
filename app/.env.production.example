# URL pública del API desplegado. Nunca usar localhost en producción.
VITE_API_URL=
VITE_TURNSTILE_SITE_KEY=

# Opcional: video hero alojado en CDN o storage público.
VITE_HERO_VIDEO_URL=

# Opcional: monitoreo de errores en producción (sentry.io).
# Sin esta variable el sistema funciona igual y no envía nada a ningún tercero.
VITE_SENTRY_DSN=
