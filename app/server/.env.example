PORT=3001
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/authentiq_dev
JWT_SECRET=cambia-esta-clave-local
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:5173
UPLOADS_DIR=../uploads

# En producción: Supabase Postgres + Storage. Nunca exponer la service role key al frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SUPABASE_STORAGE_BUCKET=vehicle-media
CRON_SECRET=un-secreto-largo-para-tareas-programadas
BOT_PROTECTION_REQUIRED=false
TURNSTILE_SECRET_KEY=

# Generación real de modelos 3D desde 1–5 fotos (servidor solamente).
# Si queda vacío, la interfaz muestra que el proveedor necesita configuración.
RODIN_API_KEY=
RODIN_API_URL=https://api.hyper3d.com/api/v2

# Email transaccional opcional. Si quedan vacías, el sistema conserva las
# notificaciones internas y no intenta llamar a ningún proveedor externo.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Showroom <noreply@tu-dominio.com>

# Facturación: no se cobra nada mientras BILLING_CHECKOUT_URL esté vacío.
BILLING_PROVIDER=none
BILLING_CHECKOUT_URL=

# Preparación OAuth: las claves no se exponen al frontend.
META_APP_ID=
META_APP_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
