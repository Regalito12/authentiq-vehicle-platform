{
  "name": "authentiq-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "create-admin": "node scripts/create-admin.js",
    "create-platform-admin": "node scripts/create-platform-admin.js",
    "seed:local-tenants": "node scripts/seed-local-tenants.js",
    "smoke": "node scripts/smoke-test.js",
    "test:roles": "node scripts/role-matrix-test.js",
    "test:tenants": "node scripts/tenant-isolation-test.js",
    "test:e2e": "node scripts/e2e-test.js",
    "migrate:3d": "node scripts/migrate-local-3d-to-supabase.mjs",
    "migrate:storefront-content": "node scripts/apply-migration.js 045_storefront_trust_content.sql",
    "migrate:production": "node scripts/apply-migration.js 045_storefront_trust_content.sql && node scripts/apply-migration.js 046_password_recovery_and_sessions.sql && node scripts/apply-migration.js 047_billing_events_and_email_outbox.sql && node scripts/apply-migration.js 048_public_request_idempotency.sql && node scripts/apply-migration.js 049_rebrand_zevroa.sql",
    "check:components": "node scripts/check-components.js",
    "check:readability": "node scripts/check-readability.mjs",
    "test:browser": "node scripts/browser-check.js",
    "verify": "node scripts/check-components.js && node scripts/check-readability.mjs && node scripts/preflight.js && node scripts/smoke-test.js && node scripts/role-matrix-test.js && node scripts/e2e-test.js",
    "preflight": "node scripts/preflight.js",
    "check:migrations": "node scripts/check-migrations.js",
    "backup:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-db.ps1 -Verify"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "latest",
    "multer": "^2.2.0",
    "pg": "latest",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0"
  }
}
