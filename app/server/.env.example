PORT=3001
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/authentiq_dev
# En Vercel usa un pool pequeño por instancia para no agotar el pooler de Supabase.
PG_POOL_MAX=2
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=5000
PG_MAX_USES=250
JWT_SECRET=cambia-esta-clave-local
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:5173
UPLOADS_DIR=../uploads

# Opcional: cada dealer aprobado obtiene automáticamente <slug>.PLATFORM_BASE_DOMAIN
# sin comprar ni configurar nada (ej. automotor.tudominio.com). Requiere: (1) comprar
# ese dominio, (2) un registro DNS comodín *.tudominio.com apuntando a este servicio,
# (3) agregar el dominio comodín en la configuración de dominios personalizados de
# Vercel. Sin esta variable, cada dealer necesita su propio dominio manual.
PLATFORM_BASE_DOMAIN=
# Opcional: slug del showroom curado que abre el botón "Ver demo". Si queda
# vacío, el CTA conserva temporalmente el inventario público de la plataforma.
PUBLIC_DEMO_SLUG=zevroa-demo

# En producción: Supabase Postgres + Storage. Nunca exponer la service role key al frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SUPABASE_STORAGE_BUCKET=vehicle-media
CRON_SECRET=un-secreto-largo-para-tareas-programadas
BOT_PROTECTION_REQUIRED=false
TURNSTILE_SECRET_KEY=

# Generación real de modelos 3D desde 1–5 fotos (servidor solamente).
# Si queda vacío, la interfaz muestra que el proveedor necesita configuración.
RODIN_API_KEY=
RODIN_API_URL=https://api.hyper3d.com/api/v2

# Email transaccional opcional. Si quedan vacías, el sistema conserva las
# notificaciones internas y no intenta llamar a ningún proveedor externo.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Showroom <noreply@tu-dominio.com>

# Facturación: no se cobra nada mientras BILLING_CHECKOUT_URL esté vacío.
BILLING_PROVIDER=none
BILLING_CHECKOUT_URL=

# Preparación OAuth: las claves no se exponen al frontend.
META_APP_ID=
META_APP_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# En producción, usa true para exigir las cuatro variables y no arrancar con
# una integración de Calendar incompleta. En local puede quedar en false.
# Calendar es opcional y no bloquea la publicación. Se considera listo cuando
# las cuatro variables estén completas y cada dealer autorice su propia cuenta.
# URL registrada exactamente en Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/integrations/google-calendar/callback
# 64 caracteres hexadecimales. En producción debe ser un secreto nuevo y estable.
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_REQUIRED=false

# Opcional: monitoreo de errores del servidor (sentry.io).
# Sin esta variable el sistema funciona igual y no envía nada a ningún tercero.
# Los eventos se etiquetan por concesionario y ruta, nunca con datos personales.
SENTRY_DSN=

# QA aislado: nunca reutilices las variables de producción para pruebas que
# creen usuarios, restauren backups o validen aislamiento entre dealers.
QA_ENVIRONMENT=qa
ZEVROA_QA_CONFIRMATION=zevroa-qa
QA_DATABASE_URL=
QA_SUPABASE_URL=
QA_SUPABASE_SERVICE_ROLE_KEY=
QA_SUPABASE_STORAGE_BUCKET=vehicle-media
QA_TEST_URL=
QA_TEST_ADMIN_EMAIL=
QA_TEST_ADMIN_PASSWORD=
