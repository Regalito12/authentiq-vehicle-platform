{
  "name": "authentiq-vehicle-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "backup:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "build": "vite build",
    "check:production": "node scripts/check-production-env.mjs",
    "check:live": "node scripts/live-check.mjs",
    "verify": "npm run check:production && npm run build && node scripts/smoke-check.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/model-viewer": "^4.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.70.0",
    "@vitejs/plugin-react": "latest",
    "browser-image-compression": "^2.0.2",
    "cmdk": "^1.1.1",
    "motion": "^12.43.0",
    "react": "latest",
    "react-dom": "latest",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "three": "^0.183.2",
    "vite": "latest",
    "vite-plugin-pwa": "^1.3.0"
  }
}
